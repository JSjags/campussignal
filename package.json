{
  "name": "campussignal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/pdf-worker.mjs && node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "db:push": "node scripts/prisma.mjs db push",
    "seed": "node --import tsx scripts/seed.ts",
    "test": "node --import tsx --test lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma.mjs generate",
    "test:api": "node --import tsx scripts/smoke.ts",
    "format": "prettier --write app components lib scripts docs *.md *.json *.ts *.mjs",
    "predev": "node scripts/pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@prisma/client": "^6.16.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^16.6.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "motion": "^14.2.0",
    "next": "^15.5.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
